#!/bin/zsh
#
# coldprint — print a secret to paper for a continuity envelope.
#
# NOTE: there is deliberately no `unset HISTFILE` here. A non-interactive zsh
# script writes no history, and values captured by `read` never enter history
# under any circumstance. Unsetting it would imply a protection that does not
# exist. The only history artifact is this script's own invocation, which is
# harmless.

emulate -L zsh

readonly OVERRIDE_TOKEN='OVERRIDE'

# classify_transport <device-uri>
# Prints one of: usb | ipps | cleartext | unknown
#
# The URI scheme alone is insufficient: dnssd:// URIs are cleartext or TLS
# depending on the advertised service type embedded in the URI. _ipps must be
# tested before _ipp.
classify_transport() {
    local uri="$1"
    case "$uri" in
        (ippusb://*|usb://*)      print -r -- "usb" ;;
        (ipps://*)                print -r -- "ipps" ;;
        (dnssd://*_ipps._tcp*)    print -r -- "ipps" ;;
        (dnssd://*_ipp._tcp*)     print -r -- "cleartext" ;;
        (ipp://*|http://*|https://*|socket://*|lpd://*|smb://*)
                                  print -r -- "cleartext" ;;
        (*)                       print -r -- "unknown" ;;
    esac
}

# Full-disk backup agents. Deliberately excludes `backupd`: it is a resident
# daemon on macOS 26 and would trip the gate on every run, training the user to
# reflex-type the override. Time Machine is covered by _tm_autobackup/_tm_running.
#
# Deliberately excludes file-sync daemons (bird/iCloud, Dropbox, Google Drive):
# `bird` runs permanently, and these sync the home directory only — the secret
# never lands there. They are named in the Tier 1 banner instead.
#
# pgrep -f (full command line) is required, not -x: ChronoSync's process is
# named "ChronoSync Scheduler" and -x misses it.
typeset -ga BACKUP_AGENT_PATTERNS=(
    bztransmit bzbkup bzserv
    Arq ccc_helper SuperDuper ChronoSync
    restic borg duplicati
)

_tm_autobackup() {
    defaults read /Library/Preferences/com.apple.TimeMachine.plist AutoBackup 2>/dev/null || true
}

_tm_running() {
    tmutil status 2>/dev/null | awk -F'=' '/Running/ { gsub(/[^0-9]/, "", $2); print $2; exit }' || true
}

_pgrep_agent() {
    pgrep -qf "$1" 2>/dev/null
}

# detect_backup_agents
# Prints one line per live backup mechanism. Empty output means clear.
detect_backup_agents() {
    local -a live
    local p

    [[ "$(_tm_autobackup)" == "1" ]] && \
        live+=("Time Machine: AutoBackup is enabled (can start mid-print)")
    [[ "$(_tm_running)" == "1" ]] && \
        live+=("Time Machine: a backup is in progress")

    for p in $BACKUP_AGENT_PATTERNS; do
        _pgrep_agent "$p" && live+=("Process: $p")
    done

    (( ${#live} )) && print -rl -- $live
    return 0
}

# print_indented <prefix> <line>...
# Prints each argument on its own line with the given prefix.
#
# A loop, not "${prefix}${^array}": inside double quotes the ^ flag collapses
# back to a single word, so the whole list prints on one line. Dropping the
# quotes instead would word-split entries that contain spaces.
print_indented() {
    local prefix="$1"; shift
    local item
    for item in "$@"; do
        print -r -- "${prefix}${item}"
    done
}

# backup_banner — Tier 1. Unconditional, every run, regardless of detection.
backup_banner() {
    print -r -- "" >&2
    print -r -- "  Pause all automatic backup, sync, and snapshot software before continuing." >&2
    print -r -- "  Time Machine - Backblaze - Arq - Carbon Copy Cloner - ChronoSync -" >&2
    print -r -- "  Dropbox - iCloud Drive - restic - borg - or anything else you run." >&2
    print -r -- "" >&2
    print -r -- "  While the job prints, it exists in cleartext in /var/spool/cups." >&2
    print -r -- "" >&2
}

# backup_gate — Tier 2. Returns 0 to proceed, 2 to abort.
backup_gate() {
    local -a live
    local reply
    live=( ${(f)"$(detect_backup_agents)"} )

    (( ${#live} )) || return 0

    print -r -- "  BLOCKED. These are live right now:" >&2
    print_indented "    " "${live[@]}" >&2
    print -r -- "" >&2
    print -r -- "  Stop them, or type ${OVERRIDE_TOKEN} to print anyway." >&2
    printf '  > ' >&2
    IFS= read -r reply || return 2

    [[ "$reply" == "$OVERRIDE_TOKEN" ]] || { print -r -- "  Aborted." >&2; return 2 }
    print -r -- "  Overridden." >&2
    return 0
}

_lpstat_v() { lpstat -v 2>/dev/null }

# enumerate_printers
# Prints "name<TAB>transport", safe transports first.
enumerate_printers() {
    local line name uri t
    local -a safe unsafe
    while IFS= read -r line; do
        [[ "$line" == device\ for\ * ]] || continue
        name="${${line#device for }%%:*}"
        uri="${line#*: }"
        t="$(classify_transport "$uri")"
        case "$t" in
            (usb|ipps)  safe+=("$name	$t") ;;
            (*)         unsafe+=("$name	$t") ;;
        esac
    done < <(_lpstat_v)
    (( ${#safe} ))   && print -rl -- $safe
    (( ${#unsafe} )) && print -rl -- $unsafe
    return 0
}

# _confirm_transport <name> <transport>
# Safe transports pass silently. Cleartext and unknown require the override
# token — the same friction as the backup gate, so there is one mental model.
_confirm_transport() {
    local name="$1" t="$2" reply
    case "$t" in
        (usb|ipps) return 0 ;;
    esac
    print -r -- "" >&2
    print -r -- "  $name uses a $t transport. The secret would cross the network unencrypted." >&2
    print -r -- "  Type ${OVERRIDE_TOKEN} to use it anyway." >&2
    printf '  > ' >&2
    IFS= read -r reply || return 1
    [[ "$reply" == "$OVERRIDE_TOKEN" ]]
}

# select_printer [preselected-name]
# Prints the chosen queue name. Returns 3 if the user refuses.
select_printer() {
    local preselect="${1:-}"
    local -a rows
    local row name t choice
    local -i i

    rows=( ${(f)"$(enumerate_printers)"} )
    (( ${#rows} )) || { print -r -- "No print queues found." >&2; return 3 }

    if [[ -n "$preselect" ]]; then
        for row in $rows; do
            [[ "${row%%	*}" == "$preselect" ]] || continue
            t="${row##*	}"
            _confirm_transport "$preselect" "$t" || return 3
            print -r -- "$preselect"
            return 0
        done
        print -r -- "No such print queue: $preselect" >&2
        return 3
    fi

    print -r -- "" >&2
    print -r -- "  Select printer:" >&2
    for (( i = 1; i <= ${#rows}; i++ )); do
        name="${rows[i]%%	*}"
        t="${rows[i]##*	}"
        case "$t" in
            (usb)  printf '    %d) %-30s usb          no network exposure\n' $i "$name" >&2 ;;
            (ipps) printf '    %d) %-30s ipps / TLS   encrypted in transit\n' $i "$name" >&2 ;;
            (*)    printf '    %d) %-30s %-12s CLEARTEXT\n' $i "$name" "$t" >&2 ;;
        esac
    done
    printf '  > ' >&2
    IFS= read -r choice || return 3

    [[ "$choice" == <-> ]] && (( choice >= 1 && choice <= ${#rows} )) || {
        print -r -- "  Invalid selection." >&2; return 3
    }

    name="${rows[choice]%%	*}"
    t="${rows[choice]##*	}"
    _confirm_transport "$name" "$t" || return 3
    print -r -- "$name"
    return 0
}

# read_secret_lines
# Reads from stdin until a blank line or EOF. Captured lines go to stdout,
# progress to stderr.
#
# Echo is suppressed with stty rather than `read -s` so that a single restore
# path covers the whole loop, and bracketed paste is explicitly disabled: if the
# terminal has it armed, a paste arrives wrapped in ESC[200~ / ESC[201~ and
# those bytes would land silently inside the secret.
read_secret_lines() {
    local -a lines
    local line saved=""
    local -i n=0 interactive=0
    [[ -t 0 ]] && interactive=1

    if (( interactive )); then
        saved="$(stty -g)"
        # Restore on any exit path, including Ctrl-C mid-secret.
        trap 'stty "$saved" 2>/dev/null; printf "\033[?2004h" >&2' EXIT INT TERM
        printf '\033[?2004l' >&2
        stty -echo
    fi

    while IFS= read -r line; do
        [[ -z "$line" ]] && break
        # Defence in depth. The ESC[?2004l above asks the terminal not to wrap
        # pastes, but tmux and some emulators re-arm it regardless. These bytes
        # are never legitimate secret content, and a silently corrupted secret
        # on paper cannot be recovered.
        if [[ "$line" == *$'\033'\[20[01]~* ]]; then
            line="${line//$'\033'\[200~/}"
            line="${line//$'\033'\[201~/}"
            print -r -- "  ! stripped a bracketed paste wrapper from this line" >&2
        fi
        lines+=("$line")
        (( n++ ))
        printf '  . line %d captured (%d chars)\n' $n ${#line} >&2
    done

    if (( interactive )); then
        stty "$saved"
        printf '\033[?2004h' >&2
        trap - EXIT INT TERM
        print -r -- "" >&2
    fi

    (( ${#lines} )) && print -rl -- $lines
    return 0
}

# flag_characters <line>...
# Prints one warning per issue. Nothing is ever stripped: a trailing space can
# be legitimate in a passphrase, and silently mutating a secret is worse than
# an ugly one.
flag_characters() {
    local -a warn
    local l
    local -i i=0
    # First line number at which each distinct line appeared. A double paste
    # of the same block is easy to do blind (echo is off), and the masked
    # preview of identical lines looks unremarkable.
    local -A seen
    for l in "$@"; do
        (( i++ ))
        [[ "$l" == *[[:space:]] ]] && \
            warn+=("line $i has trailing whitespace (preserved as-is)")
        [[ "$l" == *$'\t'* ]] && \
            warn+=("line $i contains a tab")
        [[ "$l" == *[^[:ascii:]]* ]] && \
            warn+=("line $i contains non-ASCII (prints correctly, but widens the layout)")
        if [[ -n "${seen[$l]:-}" ]]; then
            warn+=("line $i duplicates line ${seen[$l]} (double paste?)")
        else
            seen[$l]=$i
        fi
    done
    (( ${#warn} )) && print -rl -- $warn
    return 0
}

# mask_line <text>
# Lines of 5 characters or fewer are fully masked: revealing two at each end of
# a 5-character secret would expose 80% of it.
mask_line() {
    local s="$1"
    local -i n=${#s}
    local dots=""

    (( n == 0 )) && return 0
    if (( n <= 5 )); then
        repeat $n; do dots+="•"; done
        print -r -- "$dots"
        return 0
    fi
    repeat $(( n - 4 )); do dots+="•"; done
    print -r -- "${s[1,2]}${dots}${s[-2,-1]}"
}

# render_preview <label> <line>...
# Character counts are per-line content only and exclude line terminators, so
# the total differs from the checksum input length by the number of newlines.
#
# Padding is computed on character count, not with printf %-14s: the mask
# character is 3 bytes in UTF-8 and printf pads by bytes, which would misalign
# the column.
render_preview() {
    local label="$1"; shift
    local -a masks
    local -i i=0 total=0 width=0
    local l noun

    # Two passes: the column is sized to the widest mask so it never overflows.
    # A fixed width would break on any secret longer than the column, which for
    # typical recovery codes is most of them.
    for l in "$@"; do
        masks+=("$(mask_line "$l")")
        (( ${#masks[-1]} > width )) && width=${#masks[-1]}
    done

    print -r -- "Label:  $label" >&2
    print -r -- "Lines:  $#" >&2
    print -r -- "" >&2
    for l in "$@"; do
        (( i++ ))
        (( total += ${#l} ))
        printf '  [%2d] %s%*s(%d chars)\n' \
            $i "${masks[i]}" $(( width - ${#masks[i]} + 2 )) '' ${#l} >&2
    done
    print -r -- "" >&2
    noun="lines"; (( $# == 1 )) && noun="line"
    print -r -- "  Total: $# $noun, $total chars" >&2
    return 0
}

# Usable width is 612pt - 54pt - 54pt = 504pt; a character is 72/cpi points.
# Verified empirically: a 10-character string measures 72.01pt at cpi=10 and
# 60.01pt at cpi=12.
#
# The default favours legibility over avoiding wraps. Shrinking the whole page
# so one long line fits penalises every other line, and past a certain length
# it wraps anyway — paying in readability for nothing. Wrapping is already
# unambiguous because continuations are marked in the number column.
typeset -gA CPI_BUDGET=( 8 56  10 70  12 84  15 105  17 119 )
typeset -g  CPI_DEFAULT=10

# Line spacing. lpi controls leading only: a 10-character string measures
# 72.01pt at every lpi, while the line pitch moves 12pt (lpi=6) to 24pt
# (lpi=3). Blank lines between entries would be the wrong tool — they change
# the content structure, and a blank line on a secret page invites the question
# of whether it is part of the secret.
typeset -ga LPI_CHOICES=(3 4 5 6)
typeset -g  LPI_DEFAULT=4

# page_capacity <lpi>
# Printable lines per page: 792pt of Letter height less 54pt margins top and
# bottom, over the 72/lpi point line pitch.
page_capacity() {
    local -i lpi=$1
    print -r -- $(( (792 - 54 - 54) * lpi / 72 ))
}

# lpi_ok <lpi>
lpi_ok() {
    [[ -n "${LPI_CHOICES[(r)$1]}" ]]
}

# cpi_budget <cpi>
# Prints the printable characters per line at that cpi. Returns 1 if unknown.
cpi_budget() {
    local c="$1"
    [[ -n "${CPI_BUDGET[$c]:-}" ]] || return 1
    print -r -- "${CPI_BUDGET[$c]}"
}

# cpi_choices — the accepted values, smallest cpi (largest glyphs) first.
cpi_choices() {
    print -r -- "8 10 12 15 17"
}

# Ambiguous glyph pairs, in the order they print. Grouped by confusable
# cluster (0/O, 1/l/I, 2/Z, 5/S, 8/B, 9/g/q, -/_) so related shapes sit next
# to each other on the page. The legend's purpose is not to teach 0 vs O but
# to put this printer's actual glyph shapes beside their names, so only the
# glyphs the secret contains are printed — an entry for an absent glyph is
# noise, and a secret with none gets no legend at all.
typeset -ga GLYPH_LEGEND=(
    '0=zero' 'O=oh'
    '1=one' 'l=ell' 'I=eye'
    '2=two' 'Z=zee'
    '5=five' 'S=ess'
    '8=eight' 'B=bee'
    '9=nine' 'g=gee' 'q=cue'
    '-=hyphen' '_=underscore'
)

# legend_lines <width> <text>
# Prints the legend entries for the ambiguous glyphs present in <text>,
# wrapped between entries so no line exceeds <width>. No output when none.
legend_lines() {
    local -i width=$1
    local text="$2" entry line=""
    for entry in $GLYPH_LEGEND; do
        [[ "$text" == *"${entry[1]}"* ]] || continue
        if [[ -z "$line" ]]; then
            line="$entry"
        elif (( ${#line} + 2 + ${#entry} > width )); then
            print -r -- "$line"
            line="$entry"
        else
            line+="  $entry"
        fi
    done
    [[ -n "$line" ]] && print -r -- "$line"
    return 0
}

# shape_line <lines> <chars>
# "10 lines, 104 chars" — the expected dimensions, printed on the page so a
# torn or truncated sheet is detectable and a transcription can be
# length-checked before hashing.
shape_line() {
    local -i n=$1 c=$2
    local ln="lines" cn="chars"
    (( n == 1 )) && ln="line"
    (( c == 1 )) && cn="char"
    print -r -- "$n $ln, $c $cn"
}

# make_rule <label> <total>
# The horizontal rule: at least 50 dashes, widened to match an over-long
# label, clamped to the printable width. ASCII dashes — non-ASCII would break
# the cpi width math.
make_rule() {
    local label="$1" rule=""
    local -i total=$2 rule_w=${#label}
    (( rule_w < 50 )) && rule_w=50
    (( rule_w > total )) && rule_w=$total
    repeat $rule_w; do rule+="-"; done
    print -r -- "$rule"
}

# page_notes <line>...
# Notes that must reach the paper, one per line. Trailing whitespace and tabs
# print invisibly, yet the checksum includes them — a transcription that
# omits one fails the hash with nothing on the page explaining why. The
# screen warning (flag_characters) protects the author; only ink protects the
# reader.
page_notes() {
    local l
    local -i i=0
    for l in "$@"; do
        (( i++ ))
        [[ "$l" == *[[:space:]] ]] && \
            print -r -- "note: line $i ends with whitespace (part of the secret)"
        [[ "$l" == *$'\t'* ]] && \
            print -r -- "note: line $i contains a tab"
    done
    return 0
}

# gutter_width <line-count>
# Width of the number column including its trailing gap, or 0 when the secret
# is a single line and carries no numbering.
#
# Markers are parenthesised — "(1)" rather than a bare "1" — because with a
# numeric secret a bare ordinal separated only by spaces reads as part of the
# code. Parentheses delimit on both sides so the marker cannot bind to adjacent
# digits. The field is at least 4 wide so "..." continuations align, and grows
# for three-digit counts rather than silently overflowing the line budget.
gutter_width() {
    local n="$1"
    local -i w=4
    (( n <= 1 )) && { print -r -- 0; return 0 }
    (( ${#n} + 2 > w )) && w=$(( ${#n} + 2 ))
    print -r -- $(( w + 2 ))
}

# build_page <label> <date> <total-chars> [capacity] [counts]
# Reads secret lines from stdin, prints the page(s). Pure: no side effects and
# no globals beyond the glyph and cpi tables.
#
# capacity is printable lines per sheet; 0 or absent disables pagination. When
# content spills, build_page splits sheets itself with form feeds (the CUPS
# text filter honours \f, and its break math matches page_capacity) rather
# than letting the filter break the page blind. Every sheet repeats the label,
# rule, and a dated "(sheet k of K)" marker so a separated sheet is
# self-identifying; the footer prints once, on the last sheet.
#
# counts=1 adds a right-aligned (nn) column: each source line's length, on its
# last printed segment, so a mistranscription is localised to one line without
# bisecting the whole-page hash.
build_page() {
    local label="$1" date="$2"
    local -i total=$3 capacity=${4:-0} counts=${5:-0}
    local -a lines rows footer leg
    local l seg rule=""
    local -i n numbered gutter marker_w budget i rule_w first nchars=0
    local -i countw=0 reserve=0 maxlen=0 linelen last

    while IFS= read -r l; do lines+=("$l"); done
    n=${#lines}

    for l in "${lines[@]}"; do (( ${#l} > maxlen )) && maxlen=${#l}; done
    (( counts )) && { countw=$(( ${#maxlen} + 2 )); reserve=$(( countw + 2 )) }

    numbered=0; (( n > 1 )) && numbered=1
    # A single line has no gutter — unless it wraps, in which case the gutter
    # is forced so the continuation marker stays visible. Without it a wrapped
    # single-line secret reads as two lines with nothing saying so.
    (( n == 1 && ${#lines[1]} > total - reserve )) && numbered=1
    gutter="$(gutter_width $(( numbered && n == 1 ? 2 : n )))"
    marker_w=$(( gutter > 0 ? gutter - 2 : 0 ))
    budget=$(( total - gutter - reserve ))

    local joined="${(pj:\n:)lines}"
    local sum="$(printf '%s' "$joined" | shasum -a 256 | cut -c1-8)"

    rule="$(make_rule "$label" $total)"

    i=0
    for l in "${lines[@]}"; do
        (( i++ ))
        linelen=${#l}
        (( nchars += linelen ))
        first=1
        while :; do
            seg="${l[1,$budget]}"
            l="${l[$(( budget + 1 )),-1]}"
            last=0; [[ -z "$l" ]] && last=1
            local marker="..."
            (( first )) && marker="($i)"
            if (( numbered )); then
                if (( counts && last )); then
                    rows+=("$(printf '%*s  %-*s  %*s' \
                        $marker_w "$marker" $budget "$seg" $countw "($linelen)")")
                else
                    rows+=("$(printf '%*s  %s' $marker_w "$marker" "$seg")")
                fi
            elif (( counts && last )); then
                rows+=("$(printf '%-*s  %*s' $budget "$seg" $countw "($linelen)")")
            else
                rows+=("$seg")
            fi
            first=0
            (( last )) && break
        done
    done

    # Footer. The closing rule bounds the secret block — everything between
    # the two rules is the secret, character for character. Entry 1 is the
    # separating blank, dropped when the footer opens a fresh sheet (the
    # header already ends with one).
    footer=("" "$rule" "$(shape_line $n $nchars)" \
            "sha256/8: ${sum}  (LF-joined, no trailing NL)")
    local -a notes
    notes=( ${(f)"$(page_notes "${lines[@]}")"} )
    (( ${#notes} )) && footer+=("${notes[@]}")
    leg=( ${(f)"$(legend_lines $total "$joined")"} )
    (( ${#leg} )) && footer+=("${leg[@]}")

    local -i nrows=${#rows} flen=${#footer}

    if (( capacity == 0 || 4 + nrows + flen <= capacity )); then
        print -r -- "$label"
        print -r -- "$rule"
        print -r -- "$date"
        print -r -- ""
        (( nrows )) && print -rl -- "${rows[@]}"
        print -rl -- "${footer[@]}"
        return 0
    fi

    # A sheet followed by a form feed holds at most capacity-1 lines: at
    # exactly capacity the filter breaks the page on its own first, and the
    # form feed then emits a blank sheet (verified empirically against
    # cgtexttopdf). Only the last sheet may fill completely.
    local -i cap_final=$(( capacity - 4 )) cap_more=$(( capacity - 5 ))
    local -i sheets=0 idx=0 placed=0 k take
    (( cap_more < 1 )) && cap_more=1
    (( cap_final < 1 )) && cap_final=1

    # Pass 1: count sheets, so every header can say "of K". A sheet is final
    # when its remaining rows leave room for the footer; if the rows run out
    # without that, the footer takes a sheet of its own rather than spilling
    # blind.
    while (( idx < nrows )); do
        (( sheets++ ))
        if (( nrows - idx + flen <= cap_final )); then
            idx=$nrows; placed=1
        else
            (( idx += cap_more ))
        fi
    done
    (( placed )) || (( sheets++ ))

    idx=0
    for (( k = 1; k <= sheets; k++ )); do
        if (( k == 1 )); then
            print -r -- "$label"
        else
            print -r -- $'\f'"$label"
        fi
        print -r -- "$rule"
        print -r -- "$date  (sheet $k of $sheets)"
        print -r -- ""
        take=$(( nrows - idx ))
        (( k < sheets && take > cap_more )) && take=$cap_more
        (( take )) && print -rl -- "${(@)rows[$(( idx + 1 )),$(( idx + take ))]}"
        (( idx += take ))
        if (( k == sheets )); then
            if (( take )); then
                print -rl -- "${footer[@]}"
            else
                print -rl -- "${(@)footer[2,-1]}"
            fi
        fi
    done
    return 0
}

# build_envelope_slip <label> <date> <total-chars>
# Reads secret lines from stdin, prints a slip for the outside of the
# envelope: label, date, shape, checksum — never the secret itself. Future-me
# can identify an envelope's contents, and whether they were superseded,
# without breaking the seal. Pure, like build_page.
build_envelope_slip() {
    local label="$1" date="$2"
    local -i total=$3
    local -a lines
    local l
    local -i nchars=0

    while IFS= read -r l; do lines+=("$l"); done
    for l in "${lines[@]}"; do (( nchars += ${#l} )); done

    local joined="${(pj:\n:)lines}"
    local sum="$(printf '%s' "$joined" | shasum -a 256 | cut -c1-8)"

    print -r -- "$label"
    make_rule "$label" $total
    print -r -- "$date"
    shape_line ${#lines} $nchars
    print -r -- "sha256/8: ${sum}  (LF-joined, no trailing NL)"
    print -r -- ""
    print -r -- "(envelope slip; contains no secret)"
    return 0
}

# lp_options <cpi> <lpi>
# sides=one-sided is mandatory, not cosmetic: the queue default is
# *DuplexNoTumble, which would print copy 2 on the reverse of copy 1 and
# silently defeat the purpose of making two copies for two locations.
lp_options() {
    print -rl -- "-o" "cpi=$1" "-o" "lpi=$2" \
                 "-o" "page-left=54" "-o" "page-right=54" \
                 "-o" "page-top=54" "-o" "page-bottom=54" \
                 "-o" "sides=one-sided"
}

# purge_completed_jobs <printer>
# Scoped to one queue, and skipped if anything is still queued, so this can
# never cancel an unrelated print.
purge_completed_jobs() {
    local printer="$1" pending
    pending="$(lpstat -o "$printer" 2>/dev/null)"
    if [[ -n "$pending" ]]; then
        print -r -- "  Jobs still queued on $printer; skipping history purge." >&2
        return 0
    fi
    cancel -x "$printer" 2>/dev/null || true
    print -r -- "  Purged completed job history for $printer." >&2
    return 0
}

# Sample content for --dry-run. Deliberately fixed: a dry-run that accepted a
# real secret would write it in plaintext to a PDF on disk, which is precisely
# what this script exists to prevent, reachable by one wrong flag.
dry_run_sample() {
    cat <<'SAMPLE'
4fh2n8-xk3m2c
9ap7q1-w4rte1
m2x8v0-qq5nb7
t7yc44-hd91zs
b3kk09-rr2wme
z0p1la-6tn4xu
e5w7dd-oi3gvk
s8n2mq-1cf6ry
g4bt73-xz0jpe
ILlO0o1i-ambiguity-sampler
SAMPLE
}

do_dry_run() {
    local tmpd="${TMPDIR:-/tmp}"
    local out="${tmpd}/coldprint_dryrun_$$.pdf"
    local -a lines opts stale
    local l cpi lpi total
    local -i widest=0

    # Sample PDFs are harmless but used to pile up, one per run. Everything
    # matching the namespace is ours; remove predecessors so at most the
    # newest survives.
    stale=( "$tmpd"/coldprint_dryrun_*(N) )
    if (( ${#stale} )); then
        rm -f -- "${stale[@]}"
        print -r -- "Removed ${#stale} stale dry-run file(s)." >&2
    fi

    lines=( ${(f)"$(dry_run_sample)"} )
    for l in $lines; do (( ${#l} > widest )) && widest=${#l}; done

    cpi="${1:-$CPI_DEFAULT}"
    lpi="${2:-$LPI_DEFAULT}"
    local -i counts=${3:-0}
    total="$(cpi_budget $cpi)"
    opts=( ${(f)"$(lp_options $cpi $lpi)"} )

    # cupsfilter requires a filename and will not read stdin, so the page text
    # must land on disk first. This is safe only because the dry run renders
    # fixed sample content — it is the reason a real secret is never accepted
    # here. The live print path pipes straight into lp and touches no file.
    local src="${tmpd}/coldprint_dryrun_$$.txt"
    print -rl -- $lines \
        | build_page 'Dry run sample' "$(date '+%Y-%m-%d %H:%M')" \
            $total "$(page_capacity $lpi)" $counts > "$src"
    cupsfilter -m application/pdf $opts "$src" > "$out" 2>/dev/null
    rm -f "$src"

    print -r -- "Dry run written to: $out" >&2
    print -r -- "(sample content only; no secret was requested)" >&2
    return 0
}

usage() {
    cat >&2 <<'USAGE'
coldprint — print a secret to paper for a continuity envelope.

  coldprint [-P PRINTER] [-n COPIES] [--cpi N] [--lpi N] [--counts] [--envelope]
  coldprint --dry-run [--cpi N] [--lpi N] [--counts]
  coldprint -h

  -P PRINTER   Use this queue, skipping the selection menu.
  -n COPIES    Number of copies (default 1). Always one-sided.
  --cpi N      Characters per inch: 8, 10, 12, 15 or 17 (default 10).
               Lower is larger type. Long lines wrap rather than shrink
               the whole page.
  --lpi N      Lines per inch: 3, 4, 5 or 6 (default 4). Lower is more
               space between lines; it does not change the type size.
  --counts     Print each line's character count in a right-hand column,
               so a mistranscribed line can be found without bisecting
               the page checksum.
  --envelope   Also print a slip for the outside of the envelope: label,
               date, shape, checksum — no secret.
  --dry-run    Render sample content to a PDF and exit. Never asks for a secret.
  -h           This help.

Pause all backup, sync, and snapshot software before use.
USAGE
}

main() {
    local printer="" label="" reply total
    local cpi="$CPI_DEFAULT" lpi="$LPI_DEFAULT"
    local -i copies=1 counts=0 envelope=0 dryrun=0
    local -a lines warnings opts
    local l

    while (( $# )); do
        case "$1" in
            (-P) printer="${2:-}"; shift 2 ;;
            (-n) copies="${2:-1}"; shift 2 ;;
            (--cpi) cpi="${2:-}"; shift 2 ;;
            (--lpi) lpi="${2:-}"; shift 2 ;;
            (--counts) counts=1; shift ;;
            (--envelope) envelope=1; shift ;;
            (--dry-run) dryrun=1; shift ;;
            (-h|--help) usage; return 0 ;;
            (*) print -r -- "Unknown argument: $1" >&2; usage; return 1 ;;
        esac
    done

    [[ "$copies" == <-> ]] && (( copies >= 1 )) || {
        print -r -- "Copies must be a positive integer." >&2; return 1
    }
    cpi_budget "$cpi" >/dev/null || {
        print -r -- "Unsupported --cpi $cpi. Choose one of: $(cpi_choices)" >&2
        print -r -- "Lower is larger type; $CPI_DEFAULT is the default." >&2
        return 1
    }
    lpi_ok "$lpi" || {
        print -r -- "Unsupported --lpi $lpi. Choose one of: ${LPI_CHOICES}" >&2
        print -r -- "Lower is more spacing between lines; $LPI_DEFAULT is the default." >&2
        return 1
    }
    # After cpi/lpi validation, so a dry run rejects bad values the same way
    # a real run does.
    (( dryrun )) && { do_dry_run "$cpi" "$lpi" $counts; return 0 }
    [[ -t 0 ]] || {
        print -r -- "A terminal is required: the secret is read with echo disabled." >&2
        return 1
    }

    backup_banner
    backup_gate || return 2

    printer="$(select_printer "$printer")" || return 3

    printf 'Label: ' >&2
    IFS= read -r label || return 1
    [[ -n "$label" ]] || { print -r -- "A label is required." >&2; return 1 }

    print -r -- "Secret (blank line or Ctrl-D to finish):" >&2
    lines=( ${(f)"$(read_secret_lines)"} )
    (( ${#lines} )) || { print -r -- "A secret is required." >&2; return 1 }

    print -r -- "" >&2
    render_preview "$label" "${lines[@]}"

    warnings=( ${(f)"$(flag_characters "${lines[@]}")"} )
    if (( ${#warnings} )); then
        print -r -- "" >&2
        print_indented "  ! " "${warnings[@]}" >&2
    fi

    # Render up front, so every warning below describes the artifact that
    # will actually print, not a parallel computation of it. The page text
    # holds the secret and is unset alongside the lines.
    total="$(cpi_budget $cpi)"
    local stamp="$(date '+%Y-%m-%d %H:%M')"
    local page="$(print -rl -- "${lines[@]}" \
        | build_page "$label" "$stamp" $total "$(page_capacity $lpi)" $counts)"
    local slip=""
    (( envelope )) && slip="$(print -rl -- "${lines[@]}" \
        | build_envelope_slip "$label" "$stamp" $total)"

    if print -r -- "$page" | grep -q '^ *\.\.\.  '; then
        print -r -- "" >&2
        print -r -- "  ! Longest line exceeds the page width at cpi=$cpi; it will wrap," >&2
        print -r -- "    marked by ... in the number column. Use --cpi for denser text." >&2
    fi

    # A secret spanning sheets is a hazard even now that each sheet is
    # labelled "(sheet k of K)": sheets can still be separated, and half a
    # secret is no secret. Say so before printing, not after.
    local -i sheets=$(( $(print -r -- "$page" | grep -c $'\f') + 1 ))
    if (( sheets > 1 )); then
        print -r -- "" >&2
        print -r -- "  ! Spans $sheets sheets at lpi=$lpi; each is labelled '(sheet k of $sheets)'," >&2
        print -r -- "    but keep them together. --lpi 6 or --cpi 12 to fit one sheet." >&2
    fi

    print -r -- "" >&2
    printf '  Print %d cop%s%s to %s? [y/N]: ' \
        $copies "$( (( copies == 1 )) && print -n y || print -n ies )" \
        "$( (( envelope )) && print -n ' + envelope slip' )" "$printer" >&2
    IFS= read -r reply || return 0
    [[ "$reply" == [yY] ]] || {
        print -r -- "  Cancelled." >&2; unset lines label page slip; return 0
    }

    opts=( ${(f)"$(lp_options $cpi $lpi)"} )
    if ! print -r -- "$page" \
        | lp -d "$printer" -n $copies $opts >/dev/null 2>&1
    then
        print -r -- "  Print submission failed." >&2
        unset lines label page slip
        return 4
    fi

    # The slip holds no secret, so a failure here is reported but does not
    # abort: the secret page is already queued and the post-print hygiene
    # below still matters.
    if (( envelope )); then
        if ! print -r -- "$slip" \
            | lp -d "$printer" -n $copies $opts >/dev/null 2>&1
        then
            print -r -- "  Envelope slip submission failed; the secret page was submitted." >&2
        fi
    fi

    # Drops the references. It does NOT zero the memory — shell cannot do that,
    # and pretending otherwise would be worse than saying so.
    unset lines label page slip

    print -r -- "" >&2
    print -r -- "  Submitted to $printer." >&2
    lpstat -o "$printer" 2>/dev/null >&2 || true

    printf '\n  Press Enter once the page is in your hand... ' >&2
    read -r _ || true

    purge_completed_jobs "$printer"
    clear
    printf '\033[3J'
    return 0
}

[[ -n "${COLDPRINT_LIB:-}" ]] || main "$@"
